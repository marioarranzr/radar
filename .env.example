# Copy this file to .env.local and fill in the values. NEVER put real values here (public repo).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Opt-in second agent that re-checks each brief (see docs/eval-results.md)
VERIFY_BRIEFS=false
SEARCH_CONTEXT_SIZE=medium
# Evaluation only (npm run agent:eval / agent:judge); defaults to OPENAI_MODEL
JUDGE_MODEL=
DAILY_RESEARCH_LIMIT=10
DATABASE_PATH=./data/radar.db
